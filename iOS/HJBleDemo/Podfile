platform :ios, '12.0'
use_frameworks!
inhibit_all_warnings!

#source 'https://github.com/CocoaPods/Specs.git' #为github的基础源仓库，必须添加

target 'HJBleDemo' do
    pod 'Masonry','~> 1.1.0'
    pod 'wiseBle', :git => 'https://github.com/diaoerlangdang/WiseBle.git', :tag => '1.4.0'

end

target 'HJBleDemoTests' do
    pod 'wiseBle', :git => 'https://github.com/diaoerlangdang/WiseBle.git', :tag => '1.4.0'
end

post_install do |installer|
    installer.pods_project.targets.each do |target|
        target.build_configurations.each do |config|
            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
        end
    end
end
